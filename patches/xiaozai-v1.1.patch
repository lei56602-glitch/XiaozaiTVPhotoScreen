+        LinearLayout.LayoutParams photo = (LinearLayout.LayoutParams) photoView.getLayoutParams();
+        photo.width = 0; photo.weight = 0.66f; photoView.setLayoutParams(photo);
+    }
+
+    @Override public void onBackPressed() {
+        if (fullscreen) exitFullscreen(); else super.onBackPressed();
+    }
